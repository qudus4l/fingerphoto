# Copy to .env and fill in. NEVER commit .env.
# Generate keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
FP_API_KEYS=replace-with-a-long-random-key
# Encryption at rest for templates + stored photos (strongly recommended).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored originals unrecoverable (gallery frozen at the
# current SourceAFIS version) — back it up separately from the data volume.
FP_ENCRYPTION_KEY=

# Tunables (defaults shown)
#FP_THRESHOLD=50.0
#FP_MIN_MINUTIAE=15
# Ridge-structure score a crop must reach before a template is extracted.
# Calibrated by scripts/quality_calibration.py; 0 disables the score gate.
#FP_MIN_RIDGE_QUALITY=0.40
#FP_CPU_WORKERS=2
#FP_MAX_QUEUE=8
# 64 MB by default: a 5 s 4K clip from a phone is 15-35 MB.
#FP_MAX_UPLOAD_MB=64
# Frames kept from a video. Each costs a full extraction (10-20 s), so these
# are latency budgets as much as accuracy knobs.
#FP_VIDEO_FRAMES_ENROLL=3
#FP_VIDEO_FRAMES_IDENTIFY=2
# Fingerprint photos are discarded by default; only derived templates remain.
# Opt in only if you accept retaining encrypted biometric images for future
# template re-extraction after matcher upgrades.
#FP_STORE_ORIGINALS=false
#FP_JOB_TTL_S=3600
#FP_JVM_HEAP=512m
#FP_LOG_LEVEL=INFO

# Diagnostic: keep identify probe images under $FP_DATA_DIR/probes for tuning.
# Off by default — these are biometric images.
#FP_SAVE_PROBES=true
